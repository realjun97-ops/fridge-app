# Supabase 프로젝트 설정 (프로젝트 Settings > API 에서 확인)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# (선택) AI 레시피 추천용 서버 프록시 주소.
# 브라우저에서 Anthropic API 를 직접 부르면 인증 헤더·CORS 때문에 동작하지 않으므로,
# 서버(예: Vercel Serverless Function)에서 키를 보관하고 이 주소만 노출합니다.
# 설정하지 않으면 앱은 재료 기반 기본 조합 추천을 보여줍니다.
# VITE_RECIPE_API_URL=https://your-app.vercel.app/api/recipe
